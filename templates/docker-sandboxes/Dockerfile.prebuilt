# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG TEMPLATE_PLATFORM=linux/amd64
ARG SOURCE_IMAGE
ARG GO_BUILDER_IMAGE
ARG BINFMT_IMAGE

FROM --platform=${TEMPLATE_PLATFORM} ${BINFMT_IMAGE} AS qemu-source

FROM --platform=$BUILDPLATFORM ${GO_BUILDER_IMAGE} AS hook-builder
ARG TARGETOS
ARG TARGETARCH
ARG HOOK_LAUNCHER_SHA256
WORKDIR /src
COPY hook-launcher/main.go /src/main.go
RUN echo "${HOOK_LAUNCHER_SHA256}  /src/main.go" | sha256sum --check - \
    && install -d -m 0755 /out \
    && CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" GOTOOLCHAIN=local go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' -o /out/epar-hook-bash /src/main.go

FROM --platform=$BUILDPLATFORM ${GO_BUILDER_IMAGE} AS egress-bridge-builder
ARG TARGETOS
ARG TARGETARCH
ARG EGRESS_BRIDGE_SHA256
WORKDIR /src
COPY egress-bridge/main.go /src/main.go
RUN echo "${EGRESS_BRIDGE_SHA256}  /src/main.go" | sha256sum --check - \
    && install -d -m 0755 /out \
    && CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" GOTOOLCHAIN=local go build -trimpath -buildvcs=false -ldflags='-s -w -buildid=' -o /out/epar-egress-bridge /src/main.go

FROM --platform=${TEMPLATE_PLATFORM} ${SOURCE_IMAGE} AS runner-template

ARG TEMPLATE_PLATFORM
ARG SOURCE_IMAGE
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG SOURCE_PROFILE=act
ARG SOURCE_INDEX_DIGEST
ARG SOURCE_MANIFEST_DIGEST
ARG EPAR_RECIPE_DIGEST
ARG EPAR_RUNTIME_CONTRACT=docker-sandboxes-v1
ARG TEMPLATE_VERSION
ARG COMPATIBILITY_FILE=prebuilt.compatibility.json
ARG HOOK_LAUNCHER_SHA256
ARG EGRESS_BRIDGE_SHA256
ARG TINI_SHA256
ARG RUNNER_SELECTOR=selector
ARG RUNNER_VERSION
ARG RUNNER_ASSET_DIGEST
ARG ACTIONS_RUNNER_VERSION
ARG ACTIONS_RUNNER_SHA256

USER root
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

COPY guest/ /opt/epar/
COPY prebuilt/collect-software-inventory-base.sh /opt/epar/collect-software-inventory-base.sh
COPY prebuilt/host-trust-generation.disabled.json /opt/epar/host-trust-generation.disabled.json
COPY profiles/${COMPATIBILITY_FILE} /opt/epar/template-compatibility.json
COPY helpers.sha256 /opt/epar/helpers.sha256
COPY --from=hook-builder --chmod=0555 /out/epar-hook-bash /opt/epar/hook-bin/bash
COPY --from=egress-bridge-builder --chmod=0555 /out/epar-egress-bridge /opt/epar/epar-egress-bridge
COPY --from=qemu-source /usr/bin/binfmt /usr/bin/qemu-* /opt/epar/emulation/
COPY inputs/emulation-licenses/ /usr/share/licenses/epar-emulation/
COPY --chmod=0755 inputs/tini /usr/local/bin/tini
COPY inputs/actions-runner.tar.gz /tmp/actions-runner.tar.gz

RUN [[ "${TARGETPLATFORM}" == "${TEMPLATE_PLATFORM}" ]] \
    && [[ "${TARGETOS}" == "linux" ]] \
    && [[ "${TARGETARCH}" == "amd64" || "${TARGETARCH}" == "arm64" ]] \
    && echo "${TINI_SHA256#sha256:}  /usr/local/bin/tini" | sha256sum --check - \
    && cd /opt/epar \
    && sha256sum --check helpers.sha256 \
    && chmod 0555 ./*.sh \
    && install -m 0444 -o root -g root host-trust-generation.disabled.json /opt/epar/host-trust-generation.json \
    && rm -f host-trust-generation.disabled.json \
    && install -d -m 0755 -o root -g root /opt/epar/trust \
    && install -m 0444 -o root -g root /etc/ssl/certs/ca-certificates.crt /opt/epar/trust/ca-bundle.pem \
    && test -s /opt/epar/trust/ca-bundle.pem \
    && install -m 0555 enable-architecture-emulation.sh /opt/epar/enable-architecture-emulation \
    && install -m 0555 verify-native-architecture.sh /opt/epar/verify-native-architecture \
    && chmod 0555 /opt/epar/emulation/binfmt /opt/epar/emulation/qemu-* \
    && chmod 0444 /usr/share/licenses/epar-emulation/*.txt \
    && /opt/epar/prepare-template.sh \
    && echo "${ACTIONS_RUNNER_SHA256#sha256:}  /tmp/actions-runner.tar.gz" | sha256sum --check - \
    && rm -rf /opt/actions-runner \
    && install -d -m 0755 -o agent -g agent /opt/actions-runner /opt/actions-runner/_work /opt/actions-runner/_work/_tool /var/log/actions-runner \
    && tar -xzf /tmp/actions-runner.tar.gz -C /opt/actions-runner \
    && rm -f /tmp/actions-runner.tar.gz \
    && printf '%s\n' "${ACTIONS_RUNNER_VERSION}" > /opt/epar/actions-runner-version \
    && chown -R agent:agent /opt/actions-runner /var/log/actions-runner \
    && sudo -u agent -H /opt/actions-runner/bin/Runner.Listener --version | grep -Fx "${ACTIONS_RUNNER_VERSION}" \
    && chmod 0555 /opt/epar/collect-software-inventory-base.sh \
    && /usr/local/bin/tini --version 2>&1 | grep -F 'version 0.19.0'

ENV HOME=/home/agent \
    USER=agent \
    LOGNAME=agent \
    SSH_AUTH_SOCK= \
    SSH_AUTH_SOCK_GATEWAY= \
    SSH_AGENT_PID= \
    XDG_CONFIG_HOME=/home/agent/.config \
    XDG_CACHE_HOME=/home/agent/.cache \
    XDG_DATA_HOME=/home/agent/.local/share \
    XDG_STATE_HOME=/home/agent/.local/state \
    XDG_RUNTIME_DIR=/run/user/1000 \
    DOCKER_CONFIG=/home/agent/.docker \
    EPAR_TEMPLATE_PLATFORM=${TEMPLATE_PLATFORM} \
    DEBIAN_FRONTEND=dialog

LABEL com.docker.sandboxes.start-docker=true \
    io.solutionforest.epar.artifact.kind="docker-sandboxes-template-base" \
    io.solutionforest.epar.public-base="true" \
    io.solutionforest.epar.template.schema-version="2" \
    io.solutionforest.epar.runtime.contract="${EPAR_RUNTIME_CONTRACT}" \
    io.solutionforest.epar.recipe.digest="${EPAR_RECIPE_DIGEST}" \
    io.solutionforest.epar.template.profile="${SOURCE_PROFILE}" \
    io.solutionforest.epar.template.platform="${TEMPLATE_PLATFORM}" \
    io.solutionforest.epar.source.index-digest="${SOURCE_INDEX_DIGEST}" \
    io.solutionforest.epar.source.platform-digest="${SOURCE_MANIFEST_DIGEST}" \
    io.solutionforest.epar.runner.selector="${RUNNER_SELECTOR}" \
    io.solutionforest.epar.runner.version="${RUNNER_VERSION}" \
    io.solutionforest.epar.runner.asset-digest="${RUNNER_ASSET_DIGEST}" \
    io.solutionforest.epar.template.version="${TEMPLATE_VERSION}" \
    org.opencontainers.image.base.name="${SOURCE_IMAGE}"

WORKDIR /home/agent
USER agent
ENTRYPOINT ["/usr/local/bin/tini", "-g", "--", "/opt/epar/template-entrypoint.sh"]
CMD ["sleep", "infinity"]

FROM runner-template AS software-inventory
USER root
RUN install -d -m 0755 /out \
    && /opt/epar/collect-software-inventory-base.sh > /out/software-inventory.txt

FROM scratch AS software-inventory-export
COPY --from=software-inventory /out/software-inventory.txt /software-inventory.txt
