{
  "schemaVersion": 1,
  "artifactKind": "docker-sandboxes-template-base",
  "packageRepository": "ghcr.io/solutionforest/ephemeral-action-runner/docker-sandboxes-template",
  "runtimeContract": "docker-sandboxes-v1",
  "templateSchema": 2,
  "sourceRepository": "ghcr.io/catthehacker/ubuntu",
  "sourceResolution": "registry-descriptor",
  "sourceObservations": "catalog-only",
  "sourceLock": "sources.lock.json",
  "supportedPlatforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "profiles": {
    "act": {
      "sourceTag": "act-latest",
      "aliasTag": "act-latest",
      "channel": "stable",
      "enabled": true,
      "autoAdvance": true,
      "wizardDefault": false
    },
    "full": {
      "sourceTag": "full-latest",
      "aliasTag": "full-latest",
      "channel": "stable",
      "enabled": false,
      "autoAdvance": false,
      "wizardDefault": false,
      "reason": "Full remains gated until independent capacity, architecture, import/readback, and rollback validation passes"
    }
  },
  "runner": {
    "selector": "latest",
    "assetResolution": "actions-release-descriptor",
    "assetSource": "github-actions-runner-release",
    "overlayRequired": false,
    "promotion": "manual-on-tuple-change"
  },
  "verifiedBuildInputs": {
    "runnerArchive": "inputs/actions-runner.tar.gz",
    "retention": "not-retained-in-runtime-overlay",
    "identityLabels": ["selector", "version", "assetDigest"]
  },
  "publicBase": {
    "hostIndependent": true,
    "excludedPaths": [
      "custom-install",
      "host-trust-certificates",
      "trusted-ca-certificates",
      "host-trust-metadata"
    ],
    "runtimeOverlays": [
      "host-trust",
      "explicit-ca",
      "custom-install",
      "network-policy"
    ]
  },
  "requiredEvidence": [
    "provenance",
    "sbom",
    "attestation",
    "platform-runtime",
    "sandbox-import-readback"
  ]
}
