#!/usr/bin/env bash
set -euo pipefail

# EPAR entry point: ./start, ./start --config .local/config.yml, or
# ./start storage status.
#
# Uses local Go if present. Otherwise a containerized Go toolchain builds a
# CGO-disabled native host controller cached under .local/bin/<platform>, then
# runs it on the host. The no-Go fallback requires Docker. See
# docs/advanced/no-go-install.md.

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
export EPAR_INVOCATION=start
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    ps_script="$script_dir/start.ps1"
    command -v cygpath >/dev/null 2>&1 && ps_script="$(cygpath -w "$ps_script")"
    exec powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$ps_script" "$@"
    ;;
esac
cd "${script_dir}"

EPAR_HOST_TRUST_HELPER="${script_dir}/scripts/host-trust/host-trust-feed.sh"
# shellcheck disable=SC1091
. "${script_dir}/scripts/host-trust/wrapper-lib.sh"

GO_BIN="${EPAR_GO_BIN:-go}"
USE_DOCKER_RUN="${EPAR_USE_DOCKER_RUN:-auto}"
use_old=0
epar_args=("$@")
if ((${#epar_args[@]})) && [[ "${epar_args[0]}" == "--use-old" ]]; then
  use_old=1
  epar_args=("${epar_args[@]:1}")
fi
if ((${#epar_args[@]})); then
  for epar_argument in "${epar_args[@]}"; do
    if [[ "$epar_argument" == "--use-old" ]]; then
      echo '--use-old is a wrapper option and must be the first argument: ./start --use-old <command> [arguments...]' >&2
      exit 2
    fi
  done
fi
if ((${#epar_args[@]} == 0)); then
  epar_args=(start)
elif [[ "${epar_args[0]}" == -* ]]; then
  epar_args=(start "${epar_args[@]}")
fi
# A present-but-broken `go` (wrong architecture, ancient pre-modules install
# left over on PATH, etc.) must not look "usable" just because it exists.
go_usable() {
  command -v "$1" >/dev/null 2>&1 && "$1" version >/dev/null 2>&1
}

if ((use_old == 1)); then
  exec env EPAR_NATIVE_USE_OLD=1 "${script_dir}/scripts/build-native-controller.sh" "${epar_args[@]}"
fi

if [[ "${USE_DOCKER_RUN}" == "1" ]] || { [[ "${USE_DOCKER_RUN}" == "auto" ]] && ! go_usable "${GO_BIN}"; }; then
  if ! go_usable "${GO_BIN}"; then
    printf '%s\n' "Go is not installed or runnable on this machine. EPAR will use Docker's Go build environment if the project-local controller needs to be rebuilt." >&2
  else
    printf '%s\n' "EPAR is configured to use Docker's Go build environment if the project-local controller needs to be rebuilt." >&2
  fi
  exec env EPAR_NATIVE_CONTROLLER_BACKEND=docker "${script_dir}/scripts/build-native-controller.sh" "${epar_args[@]}"
fi

if ! go_usable "${GO_BIN}"; then
  echo "Go not found or not runnable: ${GO_BIN}" >&2
  echo "Install Go, set EPAR_GO_BIN, or set EPAR_USE_DOCKER_RUN=1 to use a containerized compiler instead." >&2
  echo "See docs/advanced/no-go-install.md." >&2
  exit 1
fi

exec env EPAR_NATIVE_CONTROLLER_BACKEND=local-go EPAR_NATIVE_GO_BIN="${GO_BIN}" "${script_dir}/scripts/build-native-controller.sh" "${epar_args[@]}"
